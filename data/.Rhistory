library(dplyr)
library(lubridate)
library(ggplot2)
# 1. Tu génères et affiches ton graphique
data_zone %>%
filter(date_session >= as.Date("2019-01-01")) %>%
mutate(date = floor_date(date_session, unit = "week"),
annee = factor(year(date_session)),
mai1 = as.Date(paste0(year(date_session), "-05-01")),
semaine = as.integer(as.Date(date) - mai1) %/% 7) %>%
filter(semaine >= 0, semaine <= 17) %>%
group_by(semaine, annee) %>%
summarise(n = n(), .groups = "drop") %>%
ggplot(aes(x = semaine, y = n, color = annee, group = annee)) +
geom_line() +
scale_x_continuous(
breaks = c(0, 4, 9, 13, 17),
labels = c("Mai", "Juin", "Juil.", "Août", "Sep.")
) +
labs(x = NULL, y = "Nombre d'observations", color = "Année") +
theme_minimal()
# 2. Tu ajoutes cette ligne juste en dessous pour le sauvegarder
ggsave(
filename = "observations_par_saison.png", # Le chemin et le nom du fichier
width = 7,                                         # Largeur en pouces
height = 4.5,                                      # Hauteur en pouces
dpi = 300                                          # Haute résolution (idéal pour LaTeX)
)
library(dplyr)
library(lubridate)
library(ggplot2)
data_zone %>%
# Filtrage : après 2019 ET avant le 1er janvier 2026
filter(date_session >= as.Date("2019-01-01") & date_session < as.Date("2026-01-01")) %>%
mutate(date = floor_date(date_session, unit = "week"),
annee = factor(year(date_session)),
mai1 = as.Date(paste0(year(date_session), "-05-01")),
semaine = as.integer(as.Date(date) - mai1) %/% 7) %>%
filter(semaine >= 0, semaine <= 17) %>%
group_by(semaine, annee) %>%
summarise(n = n(), .groups = "drop") %>%
ggplot(aes(x = semaine, y = n, color = annee, group = annee)) +
geom_line() +
scale_x_continuous(
breaks = c(0, 4, 9, 13, 17),
labels = c("Mai", "Juin", "Juil.", "Août", "Sep.")
) +
labs(x = NULL, y = "Nombre d'observations", color = "Année") +
theme_minimal()
# Sauvegarde du graphique épuré
ggsave(
filename = "figures/observations_par_saison.png",
width = 7,
height = 4.5,
dpi = 300
)
